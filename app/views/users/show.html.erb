<main class="container narrow">
  <header class="page-header">
    <h1>プロフィール</h1>
    <%= link_to "編集", edit_profile_path %>
  </header>

  <% flash.each do |type, message| %>
    <p class="flash <%= type %>"><%= message %></p>
  <% end %>

  <section class="card">
    <dl>
      <dt>ユーザーID</dt>
      <dd><%= @user.uid %></dd>
      <dt>年齢</dt>
      <dd><%= @user.age.presence || "未設定" %></dd>
    </dl>
  </section>

  <%= button_to "アカウント削除", profile_path, method: :delete,
    form: { data: { turbo_confirm: "アカウントと投稿を削除します。この操作は取り消せません。" } } %>

  <%= link_to "ツイート一覧へ戻る", root_path %>
</main>
